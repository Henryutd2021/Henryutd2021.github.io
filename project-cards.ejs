```{=html}
<div class="project-grid">
<% for (const item of items) { %>
<div <%= metadataAttrs(item) %> data-theme="<%= item.themekey %>" data-label="<%= item.themelabel %>">
<a class="project-card theme-<%= item.themekey %>" href="<%- item.path %>">
<span class="pc-theme"><%= item.themelabel %></span>
<h2><%= item.title %></h2>
<span class="pc-venue"><%= item.subtitle %></span>
<span class="pc-desc"><%= item.description %></span>
</a>
</div>
<% } %>
</div>
```
